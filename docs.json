{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kith Docs",
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#36c185",
    "light": "#07C983",
    "dark": "#36c185"
  },
  "background": {
  "color": {
    "light": "#FFFFFF",
    "dark": "#000000"
  }
},
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "quick-start"
            ]
          },
          {
            "group": "Using Kith",
            "pages": [
              "lumonol",
              "home",
              "messages",
              "activity-tracking",
              {
                "group": "Staff",
                "icon": "users",
                "pages": [
                  "time-off",
                  "views",
                  "directory-profile"
                ]
              },
              {
                "group": "Sessions",
                "icon": "calendar",
                "pages": [
                  "creating-sessions",
                  "joining-sessions",
                  "taking-attendance",
                  "session-boards"
                ]
              },
              {
                "group": "Knowledge Base",
                "icon": "book-text",
                "pages": [
                  "creating-content",
                  "categories"
                ]
              }
            ]
          },
          {
            "group": "Open-Source Licence",
            "pages": [
              "lumonol-software-licence-lsl-v1-0"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Moderation",
            "pages": [
              "api-reference/moderation/list-bans",
              "api-reference/moderation/check-ban",
              "api-reference/moderation/create-ban",
              "api-reference/moderation/edit-ban",
              "api-reference/moderation/delete-ban"
            ]
          },
          {
            "group": "Sessions",
            "pages": [
              "api-reference/sessions/list-sessions",
              "api-reference/sessions/list-signups",
              "api-reference/sessions/assign-role",
              "api-reference/sessions/list-servers",
              "api-reference/sessions/list-server-signups",
              "api-reference/sessions/create-server",
              "api-reference/sessions/edit-server",
              "api-reference/sessions/delete-server"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.png",
    "height": 35
  },
  "navbar": {
    "links": [
      {
        "label": "Contact Support",
        "href": "https://discord.gg/sWmeE9PWKk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Go to Kith",
      "href": "https://app.prismspace.xyz"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "appearance": {
    "strict": true,
    "default": "dark"
  }
}
