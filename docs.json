{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Lumonol Documentation",
  "icons": {
    "library": "fontawesome"
  },
  "colors": {
    "primary": "#687A58",
    "light": "#687A58",
    "dark": "#687A58"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    },
    "decoration": "gradient"
  },
  "favicon": {
    "light": "/images/lumonol-mark-dark.png",
    "dark": "/images/lumonol-mark.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Ankra",
        "icon": "layer-group",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "ankra/introduction",
              "ankra/quickstart"
            ]
          },
          {
            "group": "Using Ankra",
            "pages": [
              "ankra/staff",
              "ankra/logbook",
              "ankra/time-off",
              "ankra/activity",
              "ankra/sessions",
              "ankra/assignments",
              "ankra/knowledge"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "ankra/roles-and-permissions",
              "ankra/auto-ranking"
            ]
          },
          {
            "group": "API reference",
            "openapi": "ankra/api-reference/openapi.json",
            "pages": [
              "ankra/api-reference/introduction",
              "ankra/api-reference/authentication",
              {
                "group": "Workspace",
                "pages": [
                  "GET /get-workspace",
                  "GET /list-roles",
                  "GET /get-game-config",
                  "GET /list-ranks",
                  "GET /list-game-servers",
                  "GET /list-actions"
                ]
              },
              {
                "group": "Staff",
                "pages": [
                  "GET /list-staff",
                  "GET /get-staff-dashboard",
                  "GET /get-leaderboard",
                  "GET /list-hired-staff",
                  "GET /get-staff-member",
                  "GET /search-users",
                  "PATCH /set-rank",
                  "GET /list-online-staff",
                  "GET /list-departments",
                  "GET /get-directory"
                ]
              },
              {
                "group": "Labels",
                "pages": [
                  "GET /list-labels",
                  "GET /get-member-labels",
                  "PUT /set-member-labels"
                ]
              },
              {
                "group": "Logbook",
                "pages": [
                  "GET /get-logbook",
                  "POST /create-logbook-entry",
                  "PATCH /edit-logbook-entry",
                  "DELETE /delete-logbook-entry"
                ]
              },
              {
                "group": "Time off",
                "pages": [
                  "GET /list-timeoff",
                  "GET /get-member-timeoff",
                  "POST /create-timeoff",
                  "PATCH /review-timeoff",
                  "PATCH /adjust-timeoff",
                  "POST /end-timeoff",
                  "DELETE /delete-timeoff"
                ]
              },
              {
                "group": "Activity",
                "pages": [
                  "GET /get-member-activity",
                  "GET /list-activity-sessions",
                  "POST /add-activity",
                  "POST /sync-activity",
                  "GET /get-timesheet",
                  "PATCH /update-activity-record",
                  "DELETE /delete-activity-record",
                  "POST /end-activity-session"
                ]
              },
              {
                "group": "Sessions",
                "pages": [
                  "GET /list-session-types",
                  "POST /create-session-type",
                  "PATCH /update-session-type",
                  "DELETE /delete-session-type",
                  "GET /list-sessions",
                  "GET /get-upcoming-sessions",
                  "POST /create-session",
                  "POST /cancel-session",
                  "POST /restore-session",
                  "DELETE /delete-session",
                  "GET /get-session-signups",
                  "POST /assign-session-role",
                  "GET /list-session-servers",
                  "POST /create-session-server",
                  "PATCH /update-session-server",
                  "DELETE /delete-session-server",
                  "GET /get-session-logs",
                  "GET /list-session-roles",
                  "GET /list-session-tags"
                ]
              },
              {
                "group": "Assignments",
                "pages": [
                  "GET /list-assignments",
                  "POST /create-assignment",
                  "PATCH /update-assignment",
                  "DELETE /delete-assignment",
                  "GET /list-assignment-templates"
                ]
              },
              {
                "group": "Knowledge",
                "pages": [
                  "GET /list-kb-categories",
                  "GET /list-kb-documents",
                  "GET /get-kb-document",
                  "GET /list-kb-quick-links"
                ]
              },
              {
                "group": "Bans",
                "pages": [
                  "GET /list-bans",
                  "GET /get-ban",
                  "POST /create-ban",
                  "PATCH /update-ban",
                  "PATCH /revoke-ban"
                ]
              },
              {
                "group": "Orders",
                "pages": [
                  "GET /list-orders",
                  "GET /search-orders",
                  "POST /create-order",
                  "PATCH /update-order",
                  "GET /get-order-history"
                ]
              }
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "lumonol-software-licence-lsl-v1-0"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/LUMONOL-Logo.png",
    "dark": "/images/lumonol-logo.png",
    "height": 35,
    "href": "https://lumonol.co.uk"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact Support",
        "href": "https://discord.gg/sWmeE9PWKk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "go to lumonol Manager",
      "href": "https://manager.lumonol.co.uk"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "appearance": {
    "strict": true,
    "default": "dark"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  }
}
