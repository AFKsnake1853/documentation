            "group": "Using Kith",
            "pages": [
              "home",
              "messages",
              "activity-tracking",
              {
                "group": "Staff",
                "icon": "users",
                "pages": [
                  "time-off",
                  "views",
                  "directory-profile"
                ]
              },
              {
                "group": "Sessions",
                "icon": "calendar",
                "pages": [
                  "creating-sessions",
                  "joining-sessions",
                  "taking-attendance",
                  "session-boards"
                ]
              },
              {
                "group": "Knowledge Base",
                "icon": "book",
                "pages": [
                  "creating-content",
                  "categories"
                ]
              }
            ]
          },
          {
            "group": "Open-Source Licence",
            "pages": [
              "lumonol-software-licence-lsl-v1-0"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
